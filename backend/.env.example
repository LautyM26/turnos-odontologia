# Turnos Odontología — backend. Copiar a .env y completar. NUNCA commitear .env.
# Solo placeholders sintéticos; ningún secreto real en repo (regla dura 14).

# --- Base ---
DATABASE_URL=postgresql+psycopg://changeme:changeme@localhost:5432/turnos
APP_BASE_URL=http://localhost:8000
RESERVA_PREBLOQUEO_MIN=15
# Paso en minutos entre huecos ofrecidos por GET /api/agenda/huecos (5–60, C-05c).
AGENDA_PASO_MIN=15

# --- Auth JWT (C-03; solo backend, nunca VITE_) ---
# JWT_SECRET_KEY requerida sin default: el boot falla sin ella. 32+ chars.
JWT_SECRET_KEY=changeme-cambiar-32-caracteres-minimo-0000
JWT_ALGORITHM=HS256
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7
COOKIE_SECURE=true
RATE_LIMIT_LOGIN=5/60s
# Reserva pública sin cuenta (C-06): límites por IP.
RATE_LIMIT_PUBLICO_LECTURA=60/minute
RATE_LIMIT_PUBLICO_RESERVA=5/minute

# --- Mercado Pago (seña y saldo, C-12) ---
MP_ACCESS_TOKEN=changeme
MP_WEBHOOK_SECRET=changeme

# --- WhatsApp por sesión QR con número dedicado (DD-10, C-15) ---
# Riesgo de bloqueo/ToS de Meta asumido: ver docs/whatsapp-sesion.md.
# Gateway: vacío = no configurado (la API arranca, sesión 501); fake = simulado
# (bloqueado si ENTORNO=produccion); waha = gateway autoalojado (docker compose --profile whatsapp).
WHATSAPP_GATEWAY=fake
WHATSAPP_GATEWAY_URL=http://localhost:3000
WHATSAPP_GATEWAY_API_KEY=changeme-api-key-gateway
# Secreto HMAC-SHA512 con el que el gateway firma los eventos del webhook.
WHATSAPP_WEBHOOK_HMAC_KEY=changeme-hmac-webhook
WHATSAPP_RECORDATORIO_HORAS=24
WHATSAPP_MAX_INTENTOS=3
WHATSAPP_ENVIOS_POR_MINUTO=20

# --- ARCA factura electrónica B/C (C-13) ---
ARCA_CUIT=30-changeme
ARCA_CERT=changeme
ARCA_KEY=changeme

# --- Recetas vía partner ReNaPDiS (C-19; propia es F2) ---
RECETAS_PARTNER_KEY=changeme

# --- Comercial ---
# Costo interno por mensaje saliente en ARS (RN-WA-02; Decimal/NUMERIC, regla 7).
ARS_PRECIO_MENSAJE=0.00

# --- Adjuntos clínicos (C-08) ---
# Directorio local de adjuntos; permisos restringidos al usuario del proceso.
ADJUNTOS_STORAGE_DIR=./var/adjuntos
# Tamaño máximo por adjunto en bytes (default 10 MiB, tope 26214400).
ADJUNTO_MAX_BYTES=10485760

RECETAS_PARTNER=fake
ENTORNO=desarrollo
RECETAS_PARTNER_KEY=changeme-solo-placeholder