# Turnos Odontología — backend. Copiar a .env y completar. NUNCA commitear .env.
# Solo placeholders sintéticos; ningún secreto real en repo (regla dura 14).

# --- Base ---
DATABASE_URL=postgresql+psycopg://changeme:changeme@localhost:5432/turnos
APP_BASE_URL=http://localhost:8000
RESERVA_PREBLOQUEO_MIN=15

# --- Auth JWT (C-03; solo backend, nunca VITE_) ---
# JWT_SECRET_KEY requerida sin default: el boot falla sin ella. 32+ chars.
JWT_SECRET_KEY=changeme-cambiar-32-caracteres-minimo-0000
JWT_ALGORITHM=HS256
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7
COOKIE_SECURE=true
RATE_LIMIT_LOGIN=5/60s

# --- Mercado Pago (seña y saldo, C-12) ---
MP_ACCESS_TOKEN=changeme
MP_WEBHOOK_SECRET=changeme

# --- WhatsApp por QR con número dedicado (DECISIÓN USUARIO 2026-10-08) ---
# Contradice DD-02 / RN-WA-01 (API oficial Meta) y el "QR prohibido" de C-15/C-17:
# el usuario abandona la API oficial por considerarla no confiable. Se asume
# riesgo de bloqueo Meta/ToS; documentar sesión QR, reconexión y backup.
# Pendiente de actualizar KB (02, 09) y CHANGES fase 5. Vars sujetas a C-15.
WHATSAPP_SESSION_DIR=./data/whatsapp-session
WHATSAPP_RECONNECT=true
WHATSAPP_BACKUP_DIR=./data/whatsapp-backup
WHATSAPP_PHONE_NUMBER=54911changeme

# --- ARCA factura electrónica B/C (C-13) ---
ARCA_CUIT=30-changeme
ARCA_CERT=changeme
ARCA_KEY=changeme

# --- Recetas vía partner ReNaPDiS (C-19; propia es F2) ---
RECETAS_PARTNER_KEY=changeme

# --- Comercial ---
# Precio transparente del mensaje (string; se parsea a NUMERIC en C-08, regla 7).
ARS_PRECIO_MENSAJE=0.00

# --- Adjuntos clínicos (C-08) ---
# Directorio local de adjuntos; permisos restringidos al usuario del proceso.
ADJUNTOS_STORAGE_DIR=./var/adjuntos
# Tamaño máximo por adjunto en bytes (default 10 MiB, tope 26214400).
ADJUNTO_MAX_BYTES=10485760
